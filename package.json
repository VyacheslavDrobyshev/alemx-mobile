{
  "name": "AlemX",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator='iPhone 16'",
    "lint": "eslint . --fix --cache",
    "start": "react-native start",
    "test": "jest",
    "dc": "npm run lint && npm run tsc",
    "tsc": "tsc",
    "ci": "npm run clean:project && npm i",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:archives": "rm -rf ~/Library/Developer/Xcode/Archives",
    "clean:derived": "rm -rf ~/Library/Developer/Xcode/DerivedData",
    "clean:pods": "cd ios && pod deintegrate && pod cache clean --all",
    "clean:project": "rm -rf node_modules && rm -rf ios/Pods && rm -rf ios/Podfile.lock",
    "prepare": "husky",

    "bd:dev": "npm run bump:build && npm run dev:android && cd distribution && bundle exec fastlane store_build_version prefix:prod",

    "bump:build": "cd distribution && bundle exec fastlane bump_build_number && cd ..",
    "bump:build:android": "cd distribution && bundle exec fastlane bump_build_number_android && cd ..",
    "bump:build:ios": "cd distribution && bundle exec fastlane bump_build_number_ios && cd ..",

    "dev:android": "cd android && bundle exec fastlane ad",
    "dev:ios": "cd ios && bundle exec fastlane ad",
    "fb:login": "firebase login",

    "clean:android:cache": "rm -rf android/.cxx && rm -rf android/.gradle &&rm -rf android/app/.cxx && rm -rf android/app/.externalNativeBuild && rm -rf android/app/build && rm -rf android/build && rm -rf node_modules && rm -rf ~/.gradle/caches && rm -rf ~/.gradle/daemon && rm -rf ~/.gradle/native && rm -rf ~/.gradle/wrapper && cd android && ./gradlew clean && ../"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/slider": "^4.5.6",
    "@react-navigation/native": "6.1.10",
    "@react-navigation/native-stack": "6.9.18",
    "@reduxjs/toolkit": "^2.6.0",
    "@types/lodash": "^4.17.16",
    "axios": "^1.8.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "dayjs": "^1.11.13",
    "formik": "2.4.5",
    "lodash": "^4.17.21",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.9.1",
    "react-native-svg": "^15.11.2",
    "react-native-svg-transformer": "^1.5.0",
    "react-redux": "^9.2.0",
    "reactotron-react-native": "^5.1.12",
    "reactotron-redux": "^3.1.11",
    "redux-persist": "^6.0.0",
    "yup": "1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.78.0",
    "@react-native/eslint-config": "0.78.0",
    "@react-native/metro-config": "0.78.0",
    "@react-native/typescript-config": "0.78.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.13.2",
    "eslint": "^8.19.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "17.1.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-jsdoc": "46.9.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-native": "4.0.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "prettier": "3.1.0",
    "react-test-renderer": "19.0.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
